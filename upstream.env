# The linuxserver.io OrcaSlicer image artisanhub-orcaslicer is built from. Only published version tags are
# taken (never latest, a branch or a nightly), and the tag must still be the digest named here, so a moved
# tag fails the build instead of changing what is built. The three image lines move together; the source
# lines record the linuxserver/docker-orcaslicer commit that tag was built from.
ORCASLICER_IMAGE=lscr.io/linuxserver/orcaslicer
ORCASLICER_VERSION=v2.5.0-ls49
ORCASLICER_DIGEST=sha256:4cb6ec5e296898969be71c0a997a375835e268b8cb6bdb59968e7fe3cd6b571b
UPSTREAM_REPO=https://github.com/linuxserver/docker-orcaslicer
UPSTREAM_COMMIT=c046e423d8c74f933e69ebb7f017ced21b60be76
# The fonts the web desktop's page is set in, from the fontsource packages (SIL Open Font License 1.1).
FONTSOURCE_VERSION=5.3.0
